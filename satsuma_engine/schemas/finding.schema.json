{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/finding.schema.json",
  "title": "Satsuma Normalized Finding (findings/v1)",
  "description": "Motor çıktısı olan normalize bulgu sözleşmesi. Kurtarılan parçaları bu şemaya eşleyerek mevcut rapor/ticket hattına bağlayabilirsiniz.",
  "type": "object",
  "required": ["schema", "finding_id", "rule_id", "title", "severity", "classification", "confidence", "score", "host", "timestamp", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "findings/v1" },
    "finding_id": { "type": "string", "pattern": "^F-[0-9a-f]{16}$" },
    "dedup_key": { "type": "string", "minLength": 1 },
    "event_fingerprint": { "type": "string", "minLength": 8 },
    "rule_id": { "type": "string", "minLength": 3 },
    "rule_title": { "type": "string" },
    "title": { "type": "string", "minLength": 3, "maxLength": 300 },
    "description": { "type": "string", "maxLength": 4000 },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "classification": { "enum": ["indicator", "suspicious", "likely", "confirmed"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "category": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "score_breakdown": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "base": { "type": "integer" },
        "modifiers": { "type": "array", "items": { "type": "object", "required": ["reason", "delta"], "additionalProperties": false, "properties": { "reason": { "type": "string" }, "delta": { "type": "integer" } } } },
        "total": { "type": "integer" }
      }
    },
    "host": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 }, "os": { "type": "string" }, "ip": { "type": "string" }, "asset_criticality": { "enum": ["low", "medium", "high", "critical"] } } }
      ]
    },
    "timestamp": { "type": "string", "minLength": 10 },
    "timestamp_epoch": { "type": "number" },
    "mitre": { "type": "array", "items": { "type": "object", "required": ["technique"], "additionalProperties": false, "properties": { "tactic": { "type": "string" }, "technique": { "type": "string" }, "name": { "type": "string" } } } },
    "entity": { "type": "object", "additionalProperties": false, "properties": { "kind": { "type": "string" }, "value": { "type": "string" } } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "enum": ["event", "field", "aggregation", "correlation", "source_file"] }, "field": { "type": "string" }, "value": { "type": ["string", "number", "boolean", "null"] }, "event_index": { "type": "integer", "minimum": 0 }, "event_fingerprint": { "type": "string" }, "detail": { "type": "string" } } } },
    "observations": { "type": "object", "additionalProperties": false, "properties": { "first_seen": { "type": "string" }, "last_seen": { "type": "string" }, "occurrences": { "type": "integer", "minimum": 1 } } },
    "actions": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["open", "in_review", "explained", "false_positive", "archived"] },
    "source": { "type": "object", "additionalProperties": false, "properties": { "rule_file": { "type": "string" }, "ruleset_hash": { "type": "string" }, "engine": { "type": "string" }, "engine_version": { "type": "string" }, "raw_event": { "type": "object" } } },
    "extensions": { "type": "object" },
    "metadata": { "type": "object" }
  },
  "patternProperties": { "^x-": {} }
}
