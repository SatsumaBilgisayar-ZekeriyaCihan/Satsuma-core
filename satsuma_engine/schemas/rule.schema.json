{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/rule.schema.json",
  "title": "Satsuma Detection Rule (satsuma/v1)",
  "description": "Şema tabanlı tespit kuralı sözleşmesi. YAML veya JSON olarak yazılabilir. Bilinmeyen alanlar reddedilir; genişletme için `extensions` veya `x-` önekli alanlar kullanılmalıdır.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "severity",
    "match"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "satsuma/v1"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(-[A-Za-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "classification": {
      "enum": [
        "indicator",
        "suspicious",
        "likely",
        "confirmed"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "category": {
      "type": "string",
      "maxLength": 64
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 32
    },
    "mitre": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "technique"
        ],
        "additionalProperties": false,
        "properties": {
          "tactic": {
            "type": "string",
            "maxLength": 64
          },
          "technique": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "logsource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/selector"
        },
        "host": {
          "$ref": "#/$defs/selector"
        },
        "kind": {
          "$ref": "#/$defs/selector"
        },
        "category": {
          "$ref": "#/$defs/selector"
        },
        "action": {
          "$ref": "#/$defs/selector"
        }
      }
    },
    "match": {
      "$ref": "#/$defs/logic"
    },
    "aggregation": {
      "$ref": "#/$defs/aggregation"
    },
    "scoring": {
      "$ref": "#/$defs/scoring"
    },
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "log_only",
          "create_ticket",
          "ask_user",
          "notify_admin",
          "kill_process",
          "block_ip",
          "quarantine_file",
          "isolate_host"
        ]
      }
    },
    "suppress": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_*.-]+$"
      }
    },
    "entity": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "dedup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800,
          "default": 3600
        }
      }
    },
    "mitigation": {
      "type": "string",
      "maxLength": 1000
    },
    "extensions": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "dedup_group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "uniqueItems": true
        }
      ]
    },
    "fieldRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.\\[\\]-]+$"
    },
    "condition": {
      "type": "object",
      "required": [
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldRef"
        },
        "equals": {
          "$ref": "#/$defs/selector"
        },
        "not_equals": {
          "$ref": "#/$defs/selector"
        },
        "in": {
          "$ref": "#/$defs/selector"
        },
        "not_in": {
          "$ref": "#/$defs/selector"
        },
        "contains": {
          "type": "string"
        },
        "not_contains": {
          "type": "string"
        },
        "contains_any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "contains_all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "startswith": {
          "type": "string"
        },
        "endswith": {
          "type": "string"
        },
        "regex": {
          "type": "string",
          "maxLength": 512
        },
        "not_regex": {
          "type": "string",
          "maxLength": 512
        },
        "cidr": {
          "$ref": "#/$defs/selector"
        },
        "not_cidr": {
          "$ref": "#/$defs/selector"
        },
        "gt": {
          "type": "number"
        },
        "gte": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "exists": {
          "type": "boolean"
        },
        "length_gt": {
          "type": "integer",
          "minimum": 0
        },
        "length_lt": {
          "type": "integer",
          "minimum": 0
        },
        "ignore_case": {
          "type": "boolean",
          "default": false
        }
      },
      "anyOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "not_equals"
          ]
        },
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "not_in"
          ]
        },
        {
          "required": [
            "contains"
          ]
        },
        {
          "required": [
            "not_contains"
          ]
        },
        {
          "required": [
            "contains_any"
          ]
        },
        {
          "required": [
            "contains_all"
          ]
        },
        {
          "required": [
            "startswith"
          ]
        },
        {
          "required": [
            "endswith"
          ]
        },
        {
          "required": [
            "regex"
          ]
        },
        {
          "required": [
            "not_regex"
          ]
        },
        {
          "required": [
            "cidr"
          ]
        },
        {
          "required": [
            "not_cidr"
          ]
        },
        {
          "required": [
            "gt"
          ]
        },
        {
          "required": [
            "gte"
          ]
        },
        {
          "required": [
            "lt"
          ]
        },
        {
          "required": [
            "lte"
          ]
        },
        {
          "required": [
            "exists"
          ]
        },
        {
          "required": [
            "length_gt"
          ]
        },
        {
          "required": [
            "length_lt"
          ]
        }
      ]
    },
    "logic": {
      "oneOf": [
        {
          "$ref": "#/$defs/condition"
        },
        {
          "$ref": "#/$defs/group"
        }
      ]
    },
    "group": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/logic"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/logic"
          }
        },
        "none": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/logic"
          }
        },
        "not": {
          "$ref": "#/$defs/logic"
        }
      }
    },
    "aggregation": {
      "type": "object",
      "required": [
        "threshold",
        "window_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "threshold",
            "count_distinct"
          ],
          "default": "threshold"
        },
        "group_by": {
          "$ref": "#/$defs/selector"
        },
        "count_distinct_field": {
          "$ref": "#/$defs/fieldRef"
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "emit": {
          "enum": [
            "single",
            "per_event"
          ],
          "default": "single"
        },
        "missing_group_label": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 100
        },
        "modifiers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "if",
              "delta"
            ],
            "additionalProperties": false,
            "properties": {
              "if": {
                "$ref": "#/$defs/logic"
              },
              "delta": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              },
              "comment": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    }
  }
}
