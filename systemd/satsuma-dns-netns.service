[Unit]
Description=Satsuma DNS filter network namespace (satsuma-dns, 169.254.53.2)
Documentation=file:///usr/share/doc/satsuma-core/docs/RELEASE-2.2.44.md
Requires=satsuma-image.service
After=satsuma-image.service network-pre.target
Before=satsuma-core-dns.service

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/opt/satsuma-core
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.dns_netns setup
ExecStop=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.dns_netns teardown
# No mount namespacing here (PrivateTmp, ProtectSystem...): the namespace's
# bind mount in /run/netns must be visible to the host and to dnsmasq.
# Ad alanı bağlaması ana makinede görünmeli; bağlama ad alanı kullanılmaz.
NoNewPrivileges=yes

