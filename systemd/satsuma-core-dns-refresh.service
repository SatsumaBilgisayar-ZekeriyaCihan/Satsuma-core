[Unit]
Requires=satsuma-image.service
After=satsuma-image.service
Description=Refresh Satsuma DNS rules and expire OTX entries
After=satsuma-core-dns.service

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
User=root
Group=satsuma-dns
WorkingDirectory=/opt/satsuma-core
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.dnsmasq_control
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/satsuma-core /etc/satsuma-core/dns
