[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
Description=Satsuma core installation steps deferred by rpm-ostree
ConditionPathExists=/run/ostree-booted
After=local-fs.target systemd-sysusers.service
Before=multi-user.target

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/usr/bin/sh /usr/libexec/satsuma-ostree-firstboot
# No NoNewPrivileges on purpose: this runs the package's own %pre/%posttrans (useradd,
# SELinux labelling), whose domain changes it would refuse and every update would stop.
# Bilerek yok: paket kurulum betiklerini çalıştırır; kısıt güncellemeyi durdurur.

[Install]
WantedBy=multi-user.target
