[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
StartLimitIntervalSec=300
StartLimitBurst=3
Requires=satsuma-image.service
After=satsuma-image.service
Description=Satsuma manual three-engine scan
After=network.target satsuma-network.service
Requires=satsuma-network.service
[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
RestartPreventExitStatus=78
Type=oneshot
TimeoutStartSec=50min
User=root
Group=root
WorkingDirectory=/opt/satsuma-core
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SATSUMA_SCAN_MANUAL=1
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/main.py --security-scan
Restart=no
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
# 2.2.11: same access as the hourly scan, so detections can be quarantined.
ProtectHome=no
ReadWritePaths=/var/lib/satsuma-core -/home -/root -/tmp -/var/tmp -/dev/shm -/opt -/usr/local -/srv -/usr/bin -/usr/sbin
PrivateDevices=false
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
[Install]
WantedBy=multi-user.target
