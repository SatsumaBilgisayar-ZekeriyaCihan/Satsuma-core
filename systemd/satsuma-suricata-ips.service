[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
StartLimitIntervalSec=300
StartLimitBurst=3
Requires=satsuma-image.service
After=satsuma-image.service
Description=Satsuma Suricata IPS on NFQUEUE 100
DefaultDependencies=no
After=local-fs.target satsuma-network.service
Before=network-pre.target
Requires=satsuma-network.service
Conflicts=suricata.service
RequiresMountsFor=/etc/suricata /var/log/suricata

[Service]
# The configuration is generated from /etc/suricata/suricata.yaml at every start
# (satsuma.suricata_config, 2.2.30); the packaged file is never rewritten.
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
RestartPreventExitStatus=78
Type=simple
User=root
ExecStartPre=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/installer/ips_preflight.py
ExecStart=/usr/bin/suricata --init-errors-fatal -c /run/satsuma-suricata/suricata.yaml --runmode workers -q 100 --set stream.inline=yes --set stream.bypass=no --set nfq.mode=accept --set nfq.fail-open=no --set unix-command.filename=/run/satsuma-suricata/command.socket --pidfile /run/satsuma-suricata/ips.pid
ExecStartPost=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/installer/ips_setup.py
Restart=on-failure
RestartSec=2
RuntimeDirectory=satsuma-suricata
RuntimeDirectoryMode=0750
LogsDirectory=suricata
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/suricata /run/satsuma-suricata
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_NICE CAP_IPC_LOCK CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
