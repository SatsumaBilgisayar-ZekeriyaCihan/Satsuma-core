[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
StartLimitIntervalSec=300
StartLimitBurst=3
Requires=satsuma-image.service satsuma-dns-netns.service
After=satsuma-image.service satsuma-dns-netns.service
BindsTo=satsuma-dns-netns.service
Description=Satsuma dnsmasq domain filter (own network namespace, 169.254.53.2:53)
After=network.target
ConditionPathExists=/etc/satsuma-core/dns/dnsmasq.conf

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
RestartPreventExitStatus=78
Type=simple
User=satsuma-dns
Group=satsuma-dns
ExecStartPre=+/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/installer/dns_preflight.py
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/satsuma-core/dns/dnsmasq.conf --pid-file=
# 2.2.63: re-read added.hosts (SIGHUP) for callers that cannot signal dnsmasq themselves.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# 2.2.44 (owner's decision 2026-11-13): dnsmasq runs in its own network
# namespace and never on loopback (satsuma.dns_netns).
NetworkNamespacePath=/run/netns/satsuma-dns
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Port 53 inside the namespace; no other privilege. Yalnızca 53'e bağlanma yetkisi.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
