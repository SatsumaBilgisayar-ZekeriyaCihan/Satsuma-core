[Unit]
Description=Validate and apply edited Satsuma settings
Requires=satsuma-image.service
After=satsuma-image.service

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
User=root
WorkingDirectory=/opt/satsuma-core
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.configuration_reload
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/satsuma-core /run/satsuma-boot /etc/satsuma-core/dns
TimeoutStartSec=180
