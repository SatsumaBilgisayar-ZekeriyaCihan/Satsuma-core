[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
Requires=satsuma-image.service
After=satsuma-image.service
Description=Restore selected Satsuma LAN and DNS modes
After=satsuma-network.service satsuma-core-dns.service satsuma-suricata-ips.service satsuma-app-control.service
Requires=satsuma-network.service
Wants=satsuma-core-dns.service

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/installer/network_modes_setup.py
# 2.2.62 (faz 2): no privilege gain through setuid or file capabilities.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
