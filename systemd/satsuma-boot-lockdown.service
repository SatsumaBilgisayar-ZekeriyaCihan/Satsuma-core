[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
Description=Satsuma boot lockdown: radios off, USB modem, PPP and tuned masked
# Every boot, before the network and before any radio or modem service can
# start; the system is not trusted, so what was undone is repaired each time.
DefaultDependencies=no
Wants=satsuma-image.service
After=satsuma-image.service local-fs.target systemd-rfkill.service
Before=sysinit.target network-pre.target NetworkManager.service wpa_supplicant.service bluetooth.service ModemManager.service tuned.service tuned-ppd.service
Wants=network-pre.target
RequiresMountsFor=/opt/satsuma-core /var/lib/satsuma-core

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/opt/satsuma-core
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.boot_lockdown
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/modprobe.d /etc/modules-load.d /var/lib/systemd /var/lib/satsuma-core /run/satsuma-python-cache -/etc/cron.daily
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=sysinit.target
