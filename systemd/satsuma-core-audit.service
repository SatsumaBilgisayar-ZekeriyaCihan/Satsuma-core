[Unit]
StartLimitIntervalSec=300
StartLimitBurst=3
Requires=satsuma-image.service
After=satsuma-image.service
Description=Satsuma Core core-audit
After=network.target satsuma-network.service auditd.service
Requires=satsuma-network.service
[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
RestartPreventExitStatus=78
Type=simple
User=root
Group=root
WorkingDirectory=/opt/satsuma-core
Environment=PYTHONDONTWRITEBYTECODE=1
# Audit K4/K6: load and verify Satsuma's locked kernel audit rules first.
# Needs CAP_AUDIT_CONTROL, hence "+"; a failure never stops the worker.
ExecStartPre=-+/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/main.py --audit-rules
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/main.py --audit-worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/satsuma-core
PrivateDevices=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
[Install]
WantedBy=multi-user.target
