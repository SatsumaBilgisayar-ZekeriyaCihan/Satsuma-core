[Unit]
StartLimitIntervalSec=300
StartLimitBurst=3
Requires=satsuma-image.service
After=satsuma-image.service
Description=Satsuma read-only dashboard channel
After=satsuma-core.service

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
RestartPreventExitStatus=78
Type=simple
# 2.2.62 (faz 2): its own unprivileged user. It only reads (databases, reports, /etc settings)
# so the one capability it keeps is reading past file permissions; it can write nothing.
# Faz 2: kendi kullanıcısı; yalnız okuma yetkisi (CAP_DAC_READ_SEARCH) kalır.
User=satsuma-reader
Group=satsuma-reader
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RuntimeDirectory=satsuma-reader
RuntimeDirectoryMode=0750
UMask=0007
WorkingDirectory=/opt/satsuma-core
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.dashboard_api
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
