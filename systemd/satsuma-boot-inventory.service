[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
Requires=satsuma-image.service
After=satsuma-image.service
Description=Satsuma inventory and vetting of everything that runs in early boot
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/satsuma-core
# Keep Satsuma's SHA-256 blacklist installed in ClamAV's database directory.
ExecStartPre=-/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/main.py --hash-blacklist
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/main.py --boot-inventory
# Then the same files against Fedora's signed packages (needs the network).
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -I -B /opt/satsuma-core/main.py --signed-verify
RuntimeDirectory=satsuma-python-cache
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/satsuma-core -/var/cache/libdnf5 -/var/cache/dnf -/var/lib/clamav
NoNewPrivileges=yes
Nice=10
TimeoutStartSec=3600
