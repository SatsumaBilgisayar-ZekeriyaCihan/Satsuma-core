[Unit]
Requires=satsuma-image.service
After=satsuma-image.service satsuma-network.service satsuma-dns-netns.service
Description=Put back Satsuma firewall tables removed while their service runs
Documentation=file:///usr/share/doc/satsuma-core/docs/RELEASE-2.2.50.md

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
User=root
WorkingDirectory=/opt/satsuma-core
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.firewall_watch
TimeoutStartSec=180
