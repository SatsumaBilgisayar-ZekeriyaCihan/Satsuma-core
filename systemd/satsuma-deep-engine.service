[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
Description=Satsuma isolated rootless deep evidence engine
StartLimitIntervalSec=300
StartLimitBurst=3
Requires=satsuma-image.service
After=satsuma-image.service
Before=satsuma-teams.service
[Service]
Type=simple
User=satsuma-engine
Group=satsuma-core
WorkingDirectory=/opt/satsuma-core
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
# 2.2.38: the integrity check needs the root-only manifest key; it runs as root
# ("+") before the rootless service starts. Bütünlük denetimi root olarak önce çalışır.
ExecStartPre=+/usr/bin/python3 -I -B /opt/satsuma-core/run_deep_engine.py --verify
ExecStart=/usr/bin/python3 -I -B /opt/satsuma-core/run_deep_engine.py
Environment=PYTHONDONTWRITEBYTECODE=1
RestartPreventExitStatus=78
RuntimeDirectory=satsuma-deep
RuntimeDirectoryMode=0770
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
LimitCORE=0
[Install]
WantedBy=multi-user.target
