[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
Description=Satsuma kernel guard: read the security settings of the kernel and write back what was changed
# Reads a fixed table every second and writes back only what was weakened
# (satsuma.kernel_guard). It starts after systemd-sysctl so it never races the
# boot-time values, and it is never given up on: a guard that stops after three
# crashes protects nothing.
DefaultDependencies=no
StartLimitIntervalSec=0
Requires=satsuma-image.service
After=satsuma-image.service local-fs.target systemd-sysctl.service satsuma-memory-hardening.service
RequiresMountsFor=/opt/satsuma-core /var/lib/satsuma-core

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
User=root
WorkingDirectory=/opt/satsuma-core
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.kernel_guard --loop
Restart=always
RestartSec=1
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
# Created and made writable by systemd itself, so a missing directory cannot stop the unit.
StateDirectory=satsuma-core/kernel-guard
StateDirectoryMode=0700
# 2.2.37: a sysctl file that sets ptrace_scope away from 2 blinds the RAM scanner;
# the guard comments that one line out (satsuma.ptrace_guard). Only these paths.
# 2.2.37: ptrace_scope'u 2'den çeken sysctl satırını bekçi yorum satırına çevirir; yalnızca bu yollar.
ReadWritePaths=-/etc/sysctl.d -/etc/sysctl.conf -/run/sysctl.d -/usr/local/lib/sysctl.d -/usr/lib/sysctl.d
# Writing /proc/sys needs these; ProtectKernelTunables must stay off for the same reason.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=sysinit.target
