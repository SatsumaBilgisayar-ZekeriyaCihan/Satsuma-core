[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
Description=Satsuma maintenance kit: check every Satsuma part and repair what is safe
Requires=satsuma-image.service
After=satsuma-image.service satsuma-integrity-check.service satsuma-core.service satsuma-teams.service satsuma-reader.service

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
User=root
WorkingDirectory=/opt/satsuma-core
# Not sandboxed with ProtectSystem: it starts units, puts file modes back under
# /usr and /var and locks system accounts (usermod). Every repair is bounded and
# written to /var/lib/satsuma-core/maintenance (satsuma.maintenance).
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.maintenance
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=600
