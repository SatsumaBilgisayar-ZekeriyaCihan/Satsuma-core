[Unit]
Requires=satsuma-image.service
After=satsuma-image.service
Description=Satsuma live functional health check and bounded self repair
Wants=satsuma-integrity-check.service
After=local-fs.target satsuma-integrity-check.service satsuma-core.service satsuma-teams.service satsuma-reader.service satsuma-app-control.service satsuma-suricata-ips.service satsuma-network.service

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
User=root
WorkingDirectory=/opt/satsuma-core
ExecStart=/usr/bin/python3 -X pycache_prefix=/run/satsuma-python-cache -E -s -B -m satsuma.self_health
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ReadWritePaths=/var/lib/satsuma-core
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_READ_SEARCH
TimeoutStartSec=180
