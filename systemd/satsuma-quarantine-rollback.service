[Unit]
# 2.2.64: emergency off switch. Type satsuma.off on the kernel line in the boot menu and no
# Satsuma unit starts in that boot (the owner can always remove Satsuma). Acil kapatma anahtarı.
ConditionKernelCommandLine=!satsuma.off
Description=Satsuma: restore a quarantined program if the previous boot did not complete
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target satsuma-image.service
RequiresMountsFor=/var/lib/satsuma-core /usr
ConditionDirectoryNotEmpty=/var/lib/satsuma-core/quarantine-pending

[Service]
# Audit G3: bare program names never resolve to /usr/local.
Environment=PATH=/usr/sbin:/usr/bin
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/satsuma-quarantine-rollback boot
# 2.2.62 (faz 2): no privilege gain through setuid or file capabilities.
NoNewPrivileges=yes

[Install]
WantedBy=sysinit.target
